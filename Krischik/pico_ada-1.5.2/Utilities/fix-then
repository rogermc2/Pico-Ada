#!/bin/zsh

for I in src/**/*.ad?; do
	echo "Fix »then« for ${I}"
	vim -E -s -n <<-EOF
		edit ${I}
		global /if .*\\n\\s*then/ join
		% substitute /^\(\s*\)--  -/\1---/
		exit
	EOF
done; unset I

