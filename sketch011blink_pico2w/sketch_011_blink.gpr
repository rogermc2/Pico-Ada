
with "runtime_build.gpr";

project Sketch_011_Blink is

   for Target use runtime_build'Target;
   for Runtime ("Ada") use runtime_build'Runtime ("Ada");

   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir   use ".";
   for Main use ("sketch_01_1_blink.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-O0", "-g");
   end Compiler;
   
   package Linker is
   for Default_Switches ("Ada") use (
      "-L/System/Volumes/Data/Ada_Projects/Pico_Ada/build/, -lpico_cyw43_arch_none_static",
      "-Wl,--gc-sections", "-Wl,-e, start");
    end Linker;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

   package Builder is
      for Executable_Suffix use ".elf";
   end Builder;

end Sketch_011_Blink;