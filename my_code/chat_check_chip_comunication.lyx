\begin_layout Standard
function Check_Chip_Communication return Interfaces.Unsigned_32 is
\end_layout

\begin_layout Standard
Out_Set :
 Volatile_Word renames Reg_Ptr (System'To_Address (SIO_Base + SIO_GPIO_OUT_SET_Offset)).all;
\end_layout

\begin_layout Standard
Out_Clr :
 Volatile_Word renames Reg_Ptr (System'To_Address (SIO_Base + SIO_GPIO_OUT_CLR_Offset)).all;
\end_layout

\begin_layout Standard
-- Read (Bit 31 = 0),
 Function 0,
 Address 16#14# (Test Register),
 Length 4 Bytes
\end_layout

\begin_layout Standard
Read_Header :
 constant Interfaces.Unsigned_32 := Shift_Left(16#0014#,
 11) or 4;
\end_layout

\begin_layout Standard
Result :
 Interfaces.Unsigned_32 := 0;
\end_layout

\begin_layout Standard
begin
\end_layout

\begin_layout Standard
Out_Clr := Mask_CS;
\end_layout

\begin_layout Standard
-- Send Read Request Header
\end_layout

\begin_layout Standard
Write_gSPI_Word32 (Read_Header);
\end_layout

\begin_layout Standard
-- Enforce turnaround delay for hardware line direction swap
\end_layout

\begin_layout Standard
for I in 1 ..
 50 loop null;
 end loop;
\end_layout

\begin_layout Standard
-- Read 4 bytes back from the chip
\end_layout

\begin_layout Standard
Result := Shift_Left(Unsigned_32(Read_gSPI_Byte),
 24) or
\end_layout

\begin_layout Standard
Shift_Left(Unsigned_32(Read_gSPI_Byte),
 16) or
\end_layout

\begin_layout Standard
Shift_Left(Unsigned_32(Read_gSPI_Byte),
 8) or
\end_layout

\begin_layout Standard
Unsigned_32(Read_gSPI_Byte);
\end_layout

\begin_layout Standard
Out_Set := Mask_CS;
\end_layout

\begin_layout Standard
return Result;
\end_layout

\begin_layout Standard
end Check_Chip_Communication;
\end_layout

