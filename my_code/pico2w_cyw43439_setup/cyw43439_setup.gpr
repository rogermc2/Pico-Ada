
with "runtime_build.gpr";
with "config/cyw43439_setup_config.gpr";
with "ravenscar_build.gpr"; -- Required explicitly for light_tasking_rp2350 profiles

project CYW43439_Setup is

   for Target use Runtime_Build'Target;
   for Runtime ("Ada") use Runtime_Build'Runtime ("Ada");

   for Source_Dirs use ("src", "config", "../common", "../common/rp2350_svd");
   for Object_Dir use "obj";
   for Exec_Dir   use ".";
   for Main use ("setup.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-g", "-O0", "-gnat2022", "-mcpu=cortex-m33", "-mthumb",
         "-mfloat-abi=hard", "-mfpu=fpv5-sp-d16");
   end Compiler;

   package Linker is 
      for Switches ("Ada") use Runtime_Build.Linker_Switches &
      ("-Wl,--gc-sections", "-mcpu=cortex-m33", "-mthumb",
       "-mfloat-abi=hard", "-mfpu=fpv5-sp-d16"); -- Matches Cortex-M33 hardware float layout
   end Linker;

end CYW43439_Setup;