with "config/sketch_011_blink_config.gpr";
with "runtime_build.gpr";
with "Pico_BSP.gpr";

project Sketch_011_Blink is

   for Target use runtime_build'Target;
   for Runtime ("Ada") use runtime_build'Runtime ("Ada");

   for Source_Dirs use ("src", "config/");
   for Object_Dir use "obj" & sketch_011_blink_config.Build_Profile;
   for Exec_Dir use ".";
   for Main use ("sketch_01_1_blink.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-mcpu=cortex-m33",
         "-mthumb",
         "-mfloat-abi=hard",
         "-mfpu=fpv5-sp-d16",
         "-gnat2022", "-O0", "-g");
   end Compiler;

   package Linker is
      for Switches ("Ada") use Pico_BSP.Linker_Switches;
   end Linker;

end Sketch_011_Blink;