#!/usr/bin/env zsh
# build-all-configs.zsh — Martin Krischik, Raspberry Pi Ada Tutorial

emulate -L zsh
setopt extended_glob null_glob

typeset -r TOML="alire.toml"
typeset -r BACKUP=".backups/${TOML}"
typeset -r ACTION="${1:-build}"

if [[ $ACTION != "build" && $ACTION != "pretty" ]]; then
    print "Usage: $0 [build|pretty]" >&2
    return 1
fi

print "=== Running ${ACTION} for all optimised Alire configurations ===\n"

# The four combinations we care about
local -a configs=(
    "no_tasking:none"
    "no_tasking:debugger"
    "tasking:usb"
    "tasking:uart"
)

# Backup original once
cp -p ${TOML} ${BACKUP}

for combo in $configs; do
    local variant="${combo%%:*}"
    local output="${combo#*:}"

    print "\n→ ${ACTION} Variant=${variant} Event_Log_Output=${output}"

    # Update both defaults safely
    sed                                                         \
        -e 's/default = "no_tasking"/default = "'${variant}'"/' \
        -e 's/default = "none"/default = "'${output}'"/'        \
        < ${BACKUP} > ${TOML}

    if [[ $ACTION == "build" ]]; then
        if alr build --release; then
            print "✓ Build succeeded"
        else
            print "❌ Build failed for ${variant}/${output}" >&2
            return 1
        fi
    elif [[ $ACTION == "pretty" ]]; then
        if alr exec -P1 -- gnatpp --keep-going; then
            ../Utilities/fix-then
            print "✓ Pretty-printing succeeded"
        else
            print "⚠️  Pretty-printing had issues for ${variant}/${output}" >&2
            # Do not abort on pretty — it is not fatal
        fi
    fi
done

# Restore original alire.toml
mv ${BACKUP} ${TOML}
print "\n✓ Restored original alire.toml"

print "\n🎉 All ${ACTION} runs completed!"

