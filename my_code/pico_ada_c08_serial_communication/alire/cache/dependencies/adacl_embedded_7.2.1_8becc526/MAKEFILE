all: development

development:
	alr build --$(@)
	CD "prove_log_off"			& $(MAKE) /NOLOGO $(@)
	CD "prove_no_tasking"			& $(MAKE) /NOLOGO $(@)
	CD "prove_tasking"			& $(MAKE) /NOLOGO $(@)
	CD "test_log_off"			& $(MAKE) /NOLOGO $(@)
	CD "test_no_tasking"			& $(MAKE) /NOLOGO $(@)
	CD "test_tasking"			& $(MAKE) /NOLOGO $(@)

release:
	alr build --$(@)
	CD "prove_log_off"			& $(MAKE) /NOLOGO $(@)
	CD "prove_no_tasking"			& $(MAKE) /NOLOGO $(@)
	CD "prove_tasking"			& $(MAKE) /NOLOGO $(@)
	CD "test_log_off"			& $(MAKE) /NOLOGO $(@)
	CD "test_no_tasking"			& $(MAKE) /NOLOGO $(@)
	CD "test_tasking"			& $(MAKE) /NOLOGO $(@)

validation:
	alr build --$(@)
	CD "prove_log_off"			& $(MAKE) /NOLOGO $(@)
	CD "prove_no_tasking"			& $(MAKE) /NOLOGO $(@)
	CD "prove_tasking"			& $(MAKE) /NOLOGO $(@)
	CD "test_log_off"			& $(MAKE) /NOLOGO $(@)
	CD "test_no_tasking"			& $(MAKE) /NOLOGO $(@)
	CD "test_tasking"			& $(MAKE) /NOLOGO $(@)

test:
	CD "prove_log_off"			& $(MAKE) /NOLOGO $(@)
	CD "prove_no_tasking"			& $(MAKE) /NOLOGO $(@)
	CD "prove_tasking"			& $(MAKE) /NOLOGO $(@)
	CD "test_log_off"			& $(MAKE) /NOLOGO $(@)
	CD "test_no_tasking"			& $(MAKE) /NOLOGO $(@)
	CD "test_tasking"			& $(MAKE) /NOLOGO $(@)

pretty:
	-alr build --development
	alr exec -P1 -- gnatpp
	CD "prove_log_off"			& $(MAKE) /NOLOGO $(@)
	CD "prove_no_tasking"			& $(MAKE) /NOLOGO $(@)
	CD "prove_tasking"			& $(MAKE) /NOLOGO $(@)
	CD "test_log_off"			& $(MAKE) /NOLOGO $(@)
	CD "test_no_tasking"			& $(MAKE) /NOLOGO $(@)
	CD "test_tasking"			& $(MAKE) /NOLOGO $(@)

clean:
	alr clean
	-DEL /SEXY obj lib config alire
	alr update
	CD "prove_log_off"			& $(MAKE) /NOLOGO $(@)
	CD "prove_no_tasking"			& $(MAKE) /NOLOGO $(@)
	CD "prove_tasking"			& $(MAKE) /NOLOGO $(@)
	CD "test_log_off"			& $(MAKE) /NOLOGO $(@)
	CD "test_no_tasking"			& $(MAKE) /NOLOGO $(@)
	CD "test_tasking"			& $(MAKE) /NOLOGO $(@)

update:
	alr index --update-all
	CD "prove_log_off"			& $(MAKE) /NOLOGO $(@)
	CD "prove_no_tasking"			& $(MAKE) /NOLOGO $(@)
	CD "prove_tasking"			& $(MAKE) /NOLOGO $(@)
	CD "test_log_off"			& $(MAKE) /NOLOGO $(@)
	CD "test_no_tasking"			& $(MAKE) /NOLOGO $(@)
	CD "test_tasking"			& $(MAKE) /NOLOGO $(@)

vscode:
	Code adacl_embedded.code-workspace

