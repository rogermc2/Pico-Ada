all: validation

development:
	alr build --$(@)

release:
	alr build --$(@)

validation:
	alr build --$(@)

test: 
	alr gnatprove --level=4

pretty:
	-alr build --validation
	alr exec -P1 -- gnatpp

clean:
	-alr clean
	-DEL /SEXY obj lib config alire
	alr update

update:
	alr update

