
with "config/pico2_ada_c01_blink_lt_config.gpr";
with "runtime_build.gpr";

project Pico2_Ada_C01_Blink_LT is
   for Target              use Runtime_Build'Target;
   for Runtime ("Ada")     use Runtime_Build'Runtime ("Ada");
   for Source_Dirs         use ("src/", "config/", "../pico_xbsp/src/**");
   for Object_Dir          use "." & Pico2_Ada_C01_Blink_LT_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir            use ".";
   for Main                use ("sketch_01_2_blink.adb");

   -- Ada_Compiler_Switches := Pico2_Ada_C01_Blink_LT_Config.Ada_Compiler_Switches & (
   --       "-gnat2022",   -- Ada 2022 mode
   --       "-gnatef",     -- Display full source path name in brief error messages.
   --       "-gnatW8",     -- UTF-8 encoding (brackets encoding also recognized)
   --       "-gnatwn",     -- Set normal warnings mode.
   --       "-gnatX",      -- Language extensions permitted
   --       "-gnaty-I",    -- don't check mode IN keywords.’
   --       "-gnatyM120"); -- Set maximum line length.                                   --  Verbose mode

   -- package Compiler is
   --    for Default_Switches ("Ada") use Ada_Compiler_Switches;
   -- end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Linker is
      for Switches ("Ada") use Runtime_Build.Linker_Switches & (
         "-Wl,--gc-sections",
         "-Wl,--defsym=__stack_size=4096");
   end Linker;

   -- package Install is
   --    for Artifacts (".") use ("share");
   -- end Install;

end Pico2_Ada_C01_Blink_LT;
  