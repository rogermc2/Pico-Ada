\begin_layout Standard
procedure Initialize_gSPI is
\end_layout

\begin_layout Standard
-- Include the Control Register for Pin 23
\end_layout

\begin_layout Standard
GPIO23_Ctrl :
 Volatile_Word renames Reg_Ptr (System'To_Address (IO_BANK0_Base + 16#0BC#)).all;
 -- WL_REG_ON
\end_layout

\begin_layout Standard
GPIO24_Ctrl :
 Volatile_Word renames Reg_Ptr (System'To_Address (IO_BANK0_Base + 16#0C4#)).all;
 -- DATA
\end_layout

\begin_layout Standard
GPIO25_Ctrl :
 Volatile_Word renames Reg_Ptr (System'To_Address (IO_BANK0_Base + 16#0CC#)).all;
 -- CS
\end_layout

\begin_layout Standard
GPIO29_Ctrl :
 Volatile_Word renames Reg_Ptr (System'To_Address (IO_BANK0_Base + 16#0EC#)).all;
 -- CLK
\end_layout

\begin_layout Standard
OE_Set :
 Volatile_Word renames Reg_Ptr (System'To_Address (SIO_Base + SIO_GPIO_OE_SET_Offset)).all;
\end_layout

\begin_layout Standard
Out_Set :
 Volatile_Word renames Reg_Ptr (System'To_Address (SIO_Base + SIO_GPIO_OUT_SET_Offset)).all;
\end_layout

\begin_layout Standard
Out_Clr :
 Volatile_Word renames Reg_Ptr (System'To_Address (SIO_Base + SIO_GPIO_OUT_CLR_Offset)).all;
\end_layout

\begin_layout Standard
-- CYW43439 Function 0 Write Header to wake up clock gate
\end_layout

\begin_layout Standard
-- Sets Write bit (31),
 targets Function 0 Address 16#00A2# (gSPI Clock Control)
\end_layout

\begin_layout Standard
Wake_Header :
 constant Interfaces.Unsigned_32 := 16#8000_0000# or Shift_Left(16#00A2#,
 11) or 1;
\end_layout

\begin_layout Standard
begin
\end_layout

\begin_layout Standard
-- 1.
 Route all four control pins to SIO function (Function 5)
\end_layout

\begin_layout Standard
GPIO23_Ctrl := 5;
 
\end_layout

\begin_layout Standard
GPIO24_Ctrl := 5;
 
\end_layout

\begin_layout Standard
GPIO25_Ctrl := 5;
 
\end_layout

\begin_layout Standard
GPIO29_Ctrl := 5;
 
\end_layout

\begin_layout Standard
-- 2.
 Configure output directions and immediately isolate bus with CS high
\end_layout

\begin_layout Standard
OE_Set := Mask_CS or Mask_CLK or Mask_DATA or Mask_REG_ON;
\end_layout

\begin_layout Standard
Out_Set := Mask_CS;
 
\end_layout

\begin_layout Standard
-- 3.
 Cycle physical Power to the CYW43439 Chip
\end_layout

\begin_layout Standard
Out_Clr := Mask_REG_ON;
\end_layout

\begin_layout Standard
for I in 1 ..
 50_000 loop null;
 end loop;
 -- Settle delay
\end_layout

\begin_layout Standard
Out_Set := Mask_REG_ON;
\end_layout

\begin_layout Standard
for I in 1 ..
 250_000 loop null;
 end loop;
 -- Wait for internal wireless boot ROM to execute
\end_layout

\begin_layout Standard
-- 4.
 Tell the wireless chip to switch on its High-Throughput Clock
\end_layout

\begin_layout Standard
Out_Clr := Mask_CS;
\end_layout

\begin_layout Standard
Write_gSPI_Word32 (Wake_Header);
\end_layout

\begin_layout Standard
Write_gSPI_Byte (16#02#);
 -- Register Value 0x02 requests the internal HT Clock active
\end_layout

\begin_layout Standard
Out_Set := Mask_CS;
\end_layout

\begin_layout Standard
-- 5.
 Give the wireless clock crystal a brief window to achieve lock stability
\end_layout

\begin_layout Standard
for I in 1 ..
 100_000 loop null;
 end loop;
\end_layout

\begin_layout Standard
end Initialize_gSPI;
\end_layout

\begin_layout Standard

\end_layout

