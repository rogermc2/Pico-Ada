\end_layout

\begin_layout Standard
{
\end_layout

\begin_layout Standard
"name":
 "Debug Ada (CodeLLDB)",
\end_layout

\begin_layout Standard
"type":
 "lldb",
\end_layout

\begin_layout Standard
"request":
 "launch",
\end_layout

\begin_layout Standard
"program":
 "${workspaceFolder}/bin/your_executable_name",
\end_layout

\begin_layout Standard
"args":
 [],
\end_layout

\begin_layout Standard
"cwd":
 "${workspaceFolder}"
\end_layout

\begin_layout Standard
}
\end_layout

