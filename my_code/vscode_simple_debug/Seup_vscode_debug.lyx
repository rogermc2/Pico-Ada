]
\end_layout

\begin_layout Standard
}
\end_layout

\begin_layout Section
Alternative:
 Use the CodeLLDB Extension (Recommended for Apple Silicon)
\end_layout

\begin_layout Standard
If cppdbg still struggles to hit breakpoints or read Ada variables on ARM64 install the CodeLLDB (vadimcn.vscode-lldb) extension from the VS Code Marketplace and use "type":
 "lldb" in your launch.json instead:
\end_layout

\begin_layout LyX-Code
{
\end_layout

\begin_layout LyX-Code
"version":
 "0.2.0",
\end_layout

\begin_layout LyX-Code
"configurations":
 [
\end_layout

\begin_layout LyX-Code
{
\end_layout

\begin_layout LyX-Code
"name":
 "Debug Ada (CodeLLDB)",
\end_layout

\begin_layout LyX-Code
"type":
 "lldb",
\end_layout

\begin_layout LyX-Code
"request":
 "launch",
\end_layout

\begin_layout LyX-Code
"program":
 "${workspaceFolder}/bin/your_executable_name",
\end_layout

\begin_layout LyX-Code
"args":
 [],
\end_layout

\begin_layout LyX-Code
"cwd":
 "${workspaceFolder}"
\end_layout

\begin_layout LyX-Code
}
\end_layout

\begin_layout LyX-Code
]
\end_layout

\begin_layout LyX-Code
}
\end_layout

\begin_layout Standard
(Note:
 Make sure your project is compiled with debug symbols enabled—
Alire's default development profile includes -g automatically).
\end_layout

