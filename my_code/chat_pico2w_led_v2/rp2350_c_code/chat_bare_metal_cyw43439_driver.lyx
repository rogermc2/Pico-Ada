 Boolean;
 -- Bit 30
\end_layout

\begin_layout LyX-Code
Write_Mode :
 Boolean;
 -- Bit 31 (True = Write,
 False = Read)
\end_layout

\begin_layout LyX-Code
end record 
\end_layout

\begin_layout LyX-Code
with Size => 32;
\end_layout

\begin_layout LyX-Code
