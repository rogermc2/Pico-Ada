with "config/hello_grosser_config.gpr";
with "runtime_build.gpr";

project Hello_Grosser is
   for Target use Runtime_Build'Target;
   for Runtime ("Ada") use Runtime_Build'Runtime ("Ada");

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Hello_Grosser_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use ".";
   for Main use ("hello_grosser.adb");

   package Compiler is
      for Default_Switches ("Ada") use Hello_Grosser_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Linker is
      for Switches ("Ada") use Runtime_Build.Linker_Switches;
   end Linker;
   
   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Hello_Grosser;
