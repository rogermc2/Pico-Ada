\end_layout

\begin_layout Standard
GPIO_In :
 Volatile_Word renames Reg_Ptr (System'To_Address (SIO_Base + SIO_GPIO_IN_Offset)).all;
\end_layout

\begin_layout Standard
Result :
 Interfaces.Unsigned_8 := 0;
\end_layout

\begin_layout Standard
begin
\end_layout

\begin_layout Standard
-- Relinquish host drive control so CYW43439 can transmit
\end_layout

\begin_layout Standard
OE_Clr := Mask_DATA;
\end_layout

\begin_layout Standard
for Bit in 1 ..
 8 loop
\end_layout

\begin_layout Standard
Out_Clr := Mask_CLK;
 -- Clock Low
\end_layout

\begin_layout Standard
for I in 1 ..
 5 loop null;
 end loop;
\end_layout

\begin_layout Standard
Out_Set := Mask_CLK;
 -- Clock High
\end_layout

\begin_layout Standard
Result := Shift_Left (Result,
 1);
\end_layout

\begin_layout Standard
-- Sample line after edge propagation delay
\end_layout

\begin_layout Standard
if (GPIO_In and Mask_DATA) /= 0 then
\end_layout

\begin_layout Standard
Result := Result or 16#01#;
\end_layout

\begin_layout Standard
end if;
\end_layout

\begin_layout Standard
for I in 1 ..
 5 loop null;
 end loop;
\end_layout

\begin_layout Standard
end loop;
\end_layout

