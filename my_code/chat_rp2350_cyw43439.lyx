procedure Write_gSPI_Byte (Data :
 Interfaces.Unsigned_8) is
\end_layout

\begin_layout Standard
Out_Set :
 Volatile_Word renames Reg_Ptr (System'To_Address (SIO_Base + SIO_GPIO_OUT_SET_Offset)).all;
