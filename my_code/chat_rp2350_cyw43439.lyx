\begin_layout Standard
OE_Set :
 Volatile_Word renames Reg_Ptr (System'To_Address (SIO_Base + SIO_GPIO_OE_SET_Offset)).all;
\end_layout

\begin_layout Standard
Temp :
 Interfaces.Unsigned_8 := Data;
\end_layout

\begin_layout Standard
begin
\end_layout

\begin_layout Standard
-- Ensure host drives the shared data line
\end_layout

\begin_layout Standard
OE_Set := Mask_DATA;
\end_layout

\begin_layout Standard
-- Send MSB First
\end_layout

\begin_layout Standard
for Bit in 1 ..
 8 loop
\end_layout

\begin_layout Standard
Out_Clr := Mask_CLK;
 -- Clock Low
\end_layout

\begin_layout Standard
if (Temp and 16#80#) /= 0 then
\end_layout

\begin_layout Standard
Out_Set := Mask_DATA;
\end_layout

\begin_layout Standard
else
\end_layout

\begin_layout Standard
Out_Clr := Mask_DATA;
\end_layout

\begin_layout Standard
end if;
\end_layout

\begin_layout Standard
-- Brief delay matching CYW43439 timing constraints (up to 33MHz limit)
\end_layout

\begin_layout Standard
for I in 1 ..
 5 loop null;
 end loop;
\end_layout

\begin_layout Standard
Out_Set := Mask_CLK;
 -- Clock High (CYW43439 samples on rising edge)
\end_layout

\begin_layout Standard
Temp := Shift_Left (Temp,
 1);
\end_layout

\begin_layout Standard
for I in 1 ..
 5 loop null;
 end loop;
\end_layout

\begin_layout Standard
end loop;
\end_layout

\begin_layout Standard
end Write_gSPI_Byte;
